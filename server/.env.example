# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/offer-letter-automation

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
CANDIDATE_JWT_EXPIRES_IN=30d

# Seed Admin (used by npm run seed:admin)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Email (SMTP) - example using Gmail SMTP or SendGrid/SES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_GMAIL@gmail.com
SMTP_PASS=YOUR_16_CHARACTER_APP_PASSWORD
EMAIL_FROM="HR Team <YOUR_GMAIL@gmail.com>"

# Company branding (used in offer letter template)
COMPANY_NAME=Your Company Pvt Ltd
COMPANY_LOGO_URL=https://example.com/logo.png
COMPANY_ADDRESS=123 Business Park, Bengaluru, India

# Candidate portal base URL (link sent in the offer email)
CANDIDATE_PORTAL_URL=http://localhost:5173/candidate/login

# Google Sheets sync (optional) - one tab per department, auto-created.
# Leave blank to disable; offers will just show sheetSyncStatus: "Not configured".
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=